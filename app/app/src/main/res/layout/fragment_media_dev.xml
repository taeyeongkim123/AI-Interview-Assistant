        </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/round_corner"
                android:layout_margin="10dp"
                android:text="1. 경력과 분위기에 대해 어떻게 생각하시나요?"
                android:textSize="17dp">
            </TextView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:background="@drawable/round_corner"
                android:text="2. 개발 업무에서 어떤 역량을 갖고 계신가요?"
                android:textSize="17dp"></TextView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/round_corner"
                android:layout_margin="10dp"
                android:text="3. 회사에서 어떤 개발 경험을 가지고 계신가요? 어떤 언어를 주로 사용하셨나요?"
                android:textSize="17dp"></TextView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/round_corner"
                android:layout_margin="10dp"
                android:text="4. 개발 경험이 많을수록 어떤 방법으로 개발 작업에 임하시나요?"
                android:textSize="17dp"></TextView>


            <TextView
                android:layout_width="match_parent"
