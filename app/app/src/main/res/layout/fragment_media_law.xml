                android:layout_height="match_parent"
                android:background="@drawable/round_corner"
                android:layout_margin="10dp"
                android:text="9. 계약서 처리를 포함한 법률/법무 업무에 대한 디테일한 내용을 알고 계신가요? 테스트나 사례를 통해서 어떻게 이를 효과적으로 수행하셨나요?"
                android:textSize="17dp"></TextView>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/round_corner"
                android:layout_margin="10dp"
                android:text="10. 지금까지의 업무 경력에서 회사와 귀하의 성격이 어떻게 맞아 떨어지는지 설명해주세요. 실제 업무 환경에서 업무와 성격을 어떻게 조화롭게 이용하실 건가요?"
