                android:textSize="20dp"></TextView>
        </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/round_corner"
                android:layout_margin="10dp"
                android:text="1. 어떤 방식으로 법률/법무 업무에 대응하고 지식을 쌓아왔나요?"
                android:textSize="17dp">
            </TextView>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:background="@drawable/round_corner"
                android:text="2. 이전 회사에서 어떤 종류의 업무를 담당하였나요? 회사에 대한 기억이 있으신가요?"
                android:textSize="17dp"></TextView>



            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/round_corner"
                android:layout_margin="10dp"
                android:text="3. 지금까지의 경력 중에서 가장 도전적이고 중요한 업무는 무엇이었나요? 직원으로서 어떤 역할을 수행하였나요?"
                android:textSize="17dp"></TextView>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/round_corner"
                android:layout_margin="10dp"
                android:text="4. 법률/법무 직무에서 복잡한 상황을 다루는 방법에 대해 설명해주세요. 그리고 이러한 상황을 어떻게 기억하시나요?"
                android:textSize="17dp"></TextView>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/round_corner"
                android:layout_margin="10dp"
                android:text="5. 전체적인 기업이나 조직의 업무에 대한 이해도가 높은가요? 경력 동안 어떤 역할을 맡았나요?"
                android:textSize="17dp"></TextView>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/round_corner"
                android:layout_margin="10dp"
                android:text="6. 전공과 관련하여 자신 있는 분야와 기회를 어떻게 활용하실 건가요? 법률/법무 업무에서 주요한 문제를 어떻게 해결할 수 있는 기본적인 지식을 가지고 있으신가요?"
