        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/round_corner"
            android:layout_margin="10dp"
            android:text="4.전공 분야에 대해 개인적으로 어떤 노력을 기울였는지 알려주세요."
