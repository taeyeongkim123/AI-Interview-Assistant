        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/round_corner"
            android:layout_margin="10dp"
            android:text="3.이전 병원에서의 경력과 업무 가능 시간에 대해 말씀해주세요."
