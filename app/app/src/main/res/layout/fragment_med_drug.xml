        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/round_corner"
            android:layout_margin="10dp"
            android:text="5.회사 내에서 스트레스를 해소하는 방법과 장점에 대해 이야기해주세요."
