            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:background="@drawable/round_corner"
                android:text="불합격자들은 면접에서 회사와 기업에 대한 부정적인 느낌을 표현했습니다."
