            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:background="@drawable/round_corner"
                android:text="불합격자들은 면접 질문에 대한 부족한 답변 능력과 자기소개 능력이 문제였습니다."
